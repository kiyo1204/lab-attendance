{
    "name": "lab-attendance",
    "dockerComposeFile": "compose.yaml",
    "service": "web",
    "workspaceFolder": "/app",

    "features": {
        "ghcr.io/devcontainers/features/node:2.1.0": {
            "version": "20"
        }
    },

    "forwardPorts": [5173, 8000, "db:3306"],

    "postCreateCommand": "cd frontend && npm install ",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "eamodio.gitlens"
            ]
        }
    },

    "remoteUser": "vscode"
}
