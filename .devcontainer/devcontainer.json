{
  "name": "lab-attendance",
  "dockerComposeFile": "compose.yaml",
  "service": "web",
  "workspaceFolder": "/app",

  "features": {
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "20"
    }
  },

  "forwardPorts": [
    5173,
    8000,
    "db:3306"
  ],

  "portsAttributes": {
    "8000": {
      "label": "FastAPI"
    },
    "5173": {
      "label": "Vite"
    }
  },

  "postCreateCommand": "cd /app/backend && python -m pip install -r requirements.txt && cd /app/frontend && npm install",

  "postStartCommand": "bash /app/.devcontainer/start-dev.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ]
    }
  },

  "remoteUser": "vscode"
}